# AWS Configuration
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_REGION=ap-southeast-3
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Application Configuration
APP_NAME=Creative Fortune Teller API
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8181"]
MAX_REQUEST_SIZE=1048576
RATE_LIMIT_PER_MINUTE=60

# External Services
SSO_REGISTER_URL=<your-google-sso-url>
REDIS_URL=redis://default@127.0.0.1:6379
REDIS_TTL=86400

# LLM Configuration
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# LangWatch Configuration
LANGWATCH_API_KEY=<your-langwatch-api-key>
LANGWATCH_ENDPOINT=https://app.langwatch.ai
LANGWATCH_ENABLED=true
